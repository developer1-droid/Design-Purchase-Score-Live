# Copy this file to .env and fill in the values.

# Deployed CRM
CRM_BASE_URL=https://shazia-rice-pi-app.vercel.app

# Same value as the CRM's NEXT_PUBLIC_FIREBASE_API_KEY
FIREBASE_API_KEY=

# CRM login used by the TV server (email + password, same as the CRM login page).
# The TV reads the CRM's Purchase MIS page (/purchase-mis: hr-erp's own MIS report, framed with a token the
# CRM signs for this login) and what the Designer MIS page reads (/api/design-requests, /api/rules/resolved,
# /api/work-calendar, /api/designer-steps, /api/mis/periods). Give the login purchase_mis.view and
# designer_mis.view (a Super Admin has both).
CRM_EMAIL=
CRM_PASSWORD=

# How often to pull fresh data (seconds, at least 120). Each poll asks hr-erp for the Purchase MIS of the four
# periods and reads the whole Design Requests sheet once; every Designer MIS period is computed locally.
POLL_SECONDS=120

# Port the TV page is served on: http://localhost:4001 (Score Live itself uses 4000)
PORT=4001

# Optional PIN for saving settings from /settings.html (sent as header x-settings-pin).
# Leave empty to let anyone on the network change the TV settings.
SETTINGS_PIN=

# Optional: where the shared settings are stored (default data/settings.json).
# SETTINGS_FILE=
